{
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_1/col-3": "마침내 용기를 낸 너는 사랑하는 상대에게 함께 유성우를 보러 가자고 청한다...",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_2/col-3": "잠깐, 너 나랑 여름 한정 연애를 하고 싶다는 거야?",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_3/col-3": "세상에 맙소사!!!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_4/col-3": "아니, 뭐, 난 좋은데... 우리 사이에 아직 명백한 장애물이 있잖아...",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_5/col-3": "뭐, 사람에게 마음을 여는 게 거의 불가능하다는 네 심각한 문제?",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_6/col-3": "헥스! 아니거든! 다른 뻔한 문제 말이야!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_7/col-3": "아, 네가 이제 오븐이라는 문제? 야, 누가 신경이나 써?",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_8/col-3": "걱정 마, %CURRENTPLAYERNAME%. 오븐이 됐어도 아라비는 여전히 너에게...",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_9/col-3": "네가 무슨 말 할지 다 아니까 절대 입 밖에 내지 마!!!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_10/col-3": "...아주 '뜨겁다'고.",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_11/col-3": "으갸아아아악, 이 자식아!!!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_12/col-3": "넌 아라비와 함께 유성우를 보러 갔다! 아라비가 수평선만 똑바로 바라보지 않고 하늘을 볼 수 있게 받침대를 이리저리 기발하게 조정해야 했지만, 어떻게든 해냈다!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_13/col-3": "캠프가 끝나자 친구들은 모두 영원히 움직이지 못하는 가전제품이 된 채 앞으로 어떻게 살아야 할지 막막해했다.",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_14/col-3": "예전 삶으로 돌아갈 수도 없었지만... 너는 기발한 해결책을 떠올렸다.",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_15/col-3": "모두 함께 아파트로 이사한 것이다!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_16/col-3": "그 뒤로 오븐이 된 아라비, 라바 램프가 된 데미안, 토스터가 된 조이, 에스프레소 머신이 된 마일로와 함께 별별 황당하고 야릇한 소동이 벌어졌다...",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_17/col-3": "...더욱 컴퓨터다운 컴퓨터가 된 캘큘레스터, 세탁기 안의 물이 된 달리아, 그리고 평범한 사람인 %CURRENTPLAYERNAME%까지!",
  "english_camp_events_endings/secretending_appliances_extra_aaravi_success/secretending_appliances_extra_aaravi_success_PRE_18/col-3": "가장 섹스하고 싶은 친구 여섯을 가전제품으로 바꾸는 건 황당하고 멍청한 짓일 거라고 생각했지... 실제로 그랬어. 하지만 정말 재미있기도 했다고!"
}
