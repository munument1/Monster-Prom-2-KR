{
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_1/col-3": "넌 아라비와 헥스를 찾아간다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_2/col-3": "안녕, %CURRENTPLAYERNAME%!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_3/col-3": "정말 굉장한 모험이었지, 응?",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_4/col-3": "씨발 좋았어! 베이글 영원하라!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_5/col-3": "아니, 진심으로 정말 끝내줬어.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_6/col-3": "그러고 보니 아라비, 여름 캠프도 이제 끝나 가네.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_7/col-3": "내 기억이 맞다면 네 저주를 풀어 주는 대가로 여름 캠프의 즐거움을 경험하게 해 달라고 했었지.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_8/col-3": "그 약속을 지켰어, 자기!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_9/col-3": "그러니 이제 목걸이를 벗어도 돼. 넌 자유야!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_10/col-3": "아... 맞다...",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_11/col-3": "...아라비는 잠시 말을 잃는다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_12/col-3": "나... 정말 벗고 싶은지 모르겠어.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_13/col-3": "뭐? 진심이야?!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_14/col-3": "응, 왜 안 돼? 저주받는 것도 그렇게 나쁘지만은 않잖아?",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_15/col-3": "넌 짜증 나는 녀석이긴 하지만... 뭐랄까, 기분 좋게 짜증 나는 녀석이야. 무슨 뜻인지 알겠지?",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_16/col-3": "완전 알지! '기분 좋게 짜증 나는 녀석'이 바로 내 미들네임이거든!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_17/col-3": "그리고 솔직히 나도 여기 있는 게 좋아. 네 영혼은 꽤 아늑하거든. 조금 더 눌러앉아도 괜찮겠어.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_18/col-3": "나도 좋아.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_19/col-3": "그럼 결정됐네! '헥스와 아라비'는 앞으로도 쭉 함께야!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_20/col-3": "이거 축하해야지! %CURRENTPLAYERNAME%, 너도 함께할래? 네 덕이 정말 컸잖아!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_21/col-3": "물론 함께하지!",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_22/col-3": "셋은 해가 뜰 때까지 축하하며 밤을 보낸다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_23/col-3": "헥스의 영향 덕분에 아라비도 조금은 여유를 갖고 느긋해지는 법을 배운 모양이다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_24/col-3": "그렇게 춤추고 웃고, 인생을 위해 건배하고...",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_25/col-3": "...또다시 춤추고 웃고 건배한다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_26/col-3": "이 밤은 앞으로 오랜 세월이 흐른 뒤에도 미소 지으며 떠올릴 여름의 추억이 될 것이다.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_27/col-3": "기억을 더듬다 보면 청춘은 무엇이든 일어날 수 있었던 기묘한 세계처럼 느껴지겠지.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_28/col-3": "불과 몇 달 전만 해도 널 죽이려 들었을 괴물 사냥꾼과 그 몸에 깃든 고대의 저주와 함께, 밤과 삶 그 자체를 기꺼이 껴안았던 것처럼.",
  "english_camp_events_endings/secretending_aaraviorhex_ah/secretending_aaraviorhex_ah_PRE_29/col-3": "삶과 그 기묘하고도 아름다운 우여곡절을 위해 건배!"
}
